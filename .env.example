APP_NAME="Tienda Mr Lana"
APP_ENV=local
APP_KEY=
# Producción: APP_ENV=production y APP_DEBUG=false (obligatorio)
APP_DEBUG=true
# URL pública absoluta (canonical, Open Graph, sitemap, robots.txt, JSON-LD, correos). Sin "/" final.
# Producción: APP_URL=https://tienda.mr-lana.com · Pruebas: APP_URL=https://pruebas.mr-lana.com
APP_URL=http://localhost

# Indexación en buscadores: por defecto sólo con APP_ENV=production. En cualquier otro entorno
# (p. ej. pruebas.mr-lana.com) robots.txt responde "Disallow: /" y las páginas llevan noindex.
# SEO_INDEXAR=true|false fuerza el comportamiento (en pruebas con APP_ENV=production: SEO_INDEXAR=false).
# SEO_INDEXAR=
# Verificación de Search Console / Bing Webmaster (valor del content de la meta; ver docs/DESPLIEGUE.md).
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB 11.4 (motor InnoDB obligatorio para llaves foráneas y bloqueos de inventario/pagos)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiendamrlana
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Configure el SMTP real del dominio (no se incluyen credenciales en el repositorio)
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pagos en línea (tarjeta/Openpay). Mantener en false: la tienda cobra por transferencia y efectivo.
PAYMENTS_ONLINE_ENABLED=false

# PDF con Browsershot (spatie/browsershot + puppeteer). `npm install` descarga Chrome para puppeteer.
# Rutas absolutas sólo si node/npm/Chrome no están en el PATH del usuario que ejecuta PHP.
# Windows ejemplo: BROWSERSHOT_NODE_BINARY="C:\Program Files\nodejs\node.exe"
# Linux ejemplo:   BROWSERSHOT_NODE_BINARY=/usr/bin/node  BROWSERSHOT_NO_SANDBOX=true (si corre como root)
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_MODULES_PATH=
BROWSERSHOT_NO_SANDBOX=false
BROWSERSHOT_TIMEOUT=60
PDF_FORMATO=Letter

# CatalogoMueblesSeeder: true = adjunta fotos del catálogo y publica los muebles (como catalogo:importar-muebles --imagenes --publicar)
CATALOGO_MUEBLES_PUBLICAR=false
